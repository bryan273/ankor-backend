{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{data/**,logs/**,scripts/**,tests/**,docs/**,db/**,.venv/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/app/main" }
  ],
  "regions": ["hnd1"]
}
