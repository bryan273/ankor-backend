{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{data/**,logs/**,scripts/**,tests/**,docs/**,db/**,.venv/**,**/__pycache__/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "app/main.py" }
  ],
  "regions": ["hnd1"]
}
