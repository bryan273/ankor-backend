# --- Python / backend ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Env & secrets (never commit real keys) ---
.env*
!.env.example
*.pem
*.key
# The import scripts default --key-file to .secrets/supabase_secret_key, which holds
# the Supabase SERVICE key — full read/write on the project, bypassing row-level
# security. Nothing here matched that path, so one `git add -A` would have published it.
.secrets/
# Scraped source data the import scripts read. Absent from the repo, so without this
# line it looks like something you forgot to commit rather than something deliberate.
goldset/

# --- Node if the agent includes a gateway ---
node_modules/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Local artefacts, not source ---
# Crawl cache is hundreds of MB of fetched HTML and rebuilds itself; uploads are
# customer photos and must never reach a repo. Both are regenerable.
data/
logs/
*.log

# local vector index (regenerable)
.localvec/
