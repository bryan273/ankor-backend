# Copy to .env and fill in. Never commit the filled-in file.

# ── This service ──────────────────────────────────────────────────────────────
BACKEND_API_KEY=change-me
MAX_REACT_ITERATIONS=6

# ── Text model: DeepSeek ──────────────────────────────────────────────────────
# Measured on this workload: perceive 0.9s vs 3.2s, compose 1.4s vs 2.8s against
# gpt-5.6-terra, with longer and warmer answers. No vision, so images still go to
# terra below. Set TEXT_PROVIDER=rkapi to put everything back on one model.
TEXT_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Vision (and text fallback): RKAPI (OpenAI-compatible reseller) ────────────
# The openai-group token reaches gpt-5.6-terra and nothing else (measured).
# One key = one parallel rate lane; two requests on one key serialise (~1.9x latency).
RKAPI_BASE_URL=https://cdn.rkapi.com/v1
RKAPI_OPENAI_KEYS=sk-...,sk-...,sk-...
RKAPI_MODEL=gpt-5.6-terra
# RKAPI sits behind Cloudflare and 403s (`error code: 1010`) on a default curl/urllib
# User-Agent. The openai SDK sends its own, so this only matters for hand-rolled HTTP.

# ── Embeddings: Google AI Studio direct (RKAPI cannot serve embeddings) ───────
GEMINI_EMBED_API_KEY=AIza...
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=3072
# Fallback embedder, same 3072-d so the index shape is unchanged:
OPENAI_API_KEY=

# ── Vectors ───────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=anker-support
PINECONE_HOST=anker-support-sle6cac.svc.aped-4627-b74a.pinecone.io

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://wmxucgywnafvlnybkjhi.supabase.co
SUPABASE_REF=wmxucgywnafvlnybkjhi
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Direct connection is IPv6-only on this project and unreachable from here; the
# session-mode pooler is the working route (measured). Transaction mode (:6543)
# also connects but has no session state — use :5432 for migrations.
SUPABASE_REGION=ap-northeast-1
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=postgresql://postgres.wmxucgywnafvlnybkjhi:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ── Optional ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
DEEPGRAM_API_KEY=
VOICE_ENABLED=false
CRAWL_USER_AGENT=AnkerHackathonBot/0.1 (+https://github.com/tkc88888888/anker-hackathon-backend)
